{
  "description": "수강생판 하네스 — 원본 쓰기·영구 삭제·이름 기준 종료를 막고, «완료» 보고를 완료 조건 영수증으로 확인하며, 전수 규칙과 읽은 범위를 지킨다.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" lite_pretool.py", "timeout": 15}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" full_review_prompt.py", "timeout": 10}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" lite_stop.py", "timeout": 30},
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" full_review_stop.py", "timeout": 10},
          {"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" read_range_stop.py", "timeout": 10}
        ]
      }
    ]
  }
}
